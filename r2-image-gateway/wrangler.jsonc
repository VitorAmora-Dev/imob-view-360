{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arp-vision-public-images",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-06",
  "workers_dev": false,
  "preview_urls": false,
  // Configure o domínio no Worker, NÃO como domínio público do bucket.
  // "routes": [{ "pattern": "fotos.seu-dominio.com", "custom_domain": true }],
  "vars": {
    "API_ORIGIN": "https://configure-api.example.invalid",
    "CORS_ORIGINS": "https://configure-app.example.invalid",
    "ENVIRONMENT": "production",
  },
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "configure-bucket-privado",
    },
  ],
  // Homologação sem domínio próprio. Produção continua sem workers.dev.
  "env": {
    "homolog": {
      "name": "arp-vision-public-images-homolog",
      "account_id": "8b2c2ff1b041be08a4dcd68d3725a66a",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "API_ORIGIN": "https://imob360-api.onrender.com",
        "CORS_ORIGINS": "https://imob360-u1ge.onrender.com",
        "ENVIRONMENT": "production",
      },
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "arp-vision-fotos-homolog",
        },
      ],
      "observability": { "enabled": true, "head_sampling_rate": 1 },
    },
  },
  // PUBLIC_IMAGE_GATEWAY_SECRET é cadastrado com wrangler secret put.
}
