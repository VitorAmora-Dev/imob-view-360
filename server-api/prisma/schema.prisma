generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  ADMINISTRATOR // ADMINISTRADOR
  AGENT // CORRETOR
}

enum PropertyType {
  HOUSE // Casa
  APARTMENT // Apartamento
  LAND // Terreno
  COMMERCIAL // Comercial
  RURAL // Rural
  OFFICE // Escritório
}

enum PropertyPurpose {
  SALE // Venda
  RENT // Aluguel
  SALE_OR_RENT // Venda ou Aluguel
}

enum PropertyStatus {
  AVAILABLE // Disponível
  SOLD // Vendido
  RENTED // Alugado
  UNAVAILABLE // Indisponível
}

enum VirtualTourStatus {
  DRAFT // Rascunho
  PUBLISHED // Publicado
  ARCHIVED // Arquivado
}

/// Situação da etapa de IA que completa nadir e zênite de um panorama.
/// SKIPPED é para captura que já cobre os polos e não precisa de geração —
/// distinguir isso de DONE evita gastar API de novo a cada reprocessamento.
enum TreatmentStatus {
  PENDING // Pendente
  PROCESSING // Processando
  DONE // Concluido
  FAILED // Falhou
  SKIPPED // Dispensado
}

model User {
  id       String   @id @default(uuid())
  name     String // nome
  email    String   @unique
  password String // senha
  type     UserType // tipo

  // específico de Corretor
  licenseNumber String? // creci
  agency        Agency? @relation(fields: [agencyId], references: [id]) // imobiliaria
  agencyId      String?

  properties Property[] // imoveis
  sessions   Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Mesmo caso de Property: `GET /users` filtra por agência e ordena por nome.
  @@index([agencyId, name])
}

model Session {
  id          String   @id @default(uuid())
  hashedToken String   @db.Text
  expiresAt   DateTime

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())

  @@index([userId])
}

model Agency {
  id    String  @id @default(uuid())
  name  String // nome
  taxId String? @unique // cnpj
  email String?
  phone String? // telefone

  agents     User[] // corretores
  properties Property[] // imoveis

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Property {
  id          String          @id @default(uuid())
  code        String          @unique // codigo
  title       String // titulo
  description String? // descricao
  type        PropertyType // tipo
  purpose     PropertyPurpose // finalidade
  price       Float? // valor
  totalArea   Float? // areaTotal
  status      PropertyStatus  @default(AVAILABLE)

  agency   Agency  @relation(fields: [agencyId], references: [id]) // imobiliaria
  agencyId String
  agent    User?   @relation(fields: [agentId], references: [id]) // corretor
  agentId  String?

  /// Quais destes campos ainda são MARCADOR, e não escolha do corretor.
  ///
  /// O wizard cria o imóvel na primeira foto, para o tour existir e a montagem
  /// por IA poder rodar durante a captura. Mas `title`, `type` e `purpose` são
  /// obrigatórios, e nesse instante o corretor não informou nenhum — então
  /// entram valores de marcador ("Captura em andamento", HOUSE, SALE) que a
  /// coluna sozinha não distingue de uma escolha de verdade.
  ///
  /// A retomada usava o título como discriminador dos três, e isso quebra: o
  /// salvamento grava campo a campo, então digitar o nome na última etapa e o
  /// app ir para segundo plano sobe um PATCH só com `title`. Na volta, o título
  /// já não era marcador e `type`/`purpose` voltavam como Casa/Venda válidos —
  /// publicando um apartamento para alugar rotulado como casa à venda.
  ///
  /// Vazio em imóvel de cadastro normal, que nunca teve marcador nenhum.
  draftPlaceholders String[] @default([]) // camposMarcador

  address     Address? // endereco
  virtualTour VirtualTour? // tourVirtual

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// `GET /properties` filtra sempre por agência e ordena por `createdAt desc`.
  /// Com índice só em `agencyId`, o Postgres achava as linhas da agência e
  /// ordenava todas elas a cada página. O composto substitui o simples: um
  /// índice `(a, b)` atende tudo o que `(a)` atendia, então manter os dois seria
  /// pagar escrita em dobro pela mesma leitura.
  @@index([agencyId, createdAt])
  @@index([agentId])
  @@index([type, purpose, status])
}

model Address {
  id         String  @id @default(uuid())
  street     String // logradouro
  number     String? // numero
  complement String? // complemento
  district   String? // bairro
  city       String // cidade
  state      String // estado
  zipCode    String? // cep

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade) // imovel
  propertyId String   @unique
}

model VirtualTour {
  id        String            @id @default(uuid())
  createdAt DateTime          @default(now())
  status    VirtualTourStatus @default(DRAFT)

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade) // imovel
  propertyId String   @unique

  panoramas Panorama[] // panoramas
  shares    Share[] // compartilhamentos
  views     View[] // visualizacoes

  updatedAt DateTime @updatedAt
}

model Panorama {
  id              String  @id @default(uuid())
  roomName        String // nomeComodo
  imageData       String  @db.Text // base64 JPEG
  order           Int     @default(0) // ordem
  initialPanorama Boolean @default(false) // panoramaInicial

  /// Geometria da captura, quando o panorama veio da câmera guiada.
  ///
  /// O preenchimento dos polos é deliberadamente plausível — sem estes números
  /// não há como distinguir pixel fotografado de pixel inventado, e a etapa de
  /// IA precisa saber a diferença. Servem também de telemetria: é assim que se
  /// vê, em campo, se o ajuste de campo de visão está acertando.
  fittedVfovDeg Float? // campoVerticalAjustado
  bandTopDeg    Float? // latitudeSuperiorFotografada
  bandBottomDeg Float? // latitudeInferiorFotografada

  /// Resultado da etapa de IA, que completa nadir e zênite — os ~27% da esfera
  /// que a câmera nunca aponta e que hoje saem como borrão.
  ///
  /// Fica ao lado de `imageData`, e não no lugar dele, por três motivos: o
  /// original é a única prova do que foi realmente fotografado, o tratamento
  /// pode ser refeito com um modelo melhor sem nova captura, e um resultado
  /// ruim precisa ser revertido sem perder o panorama.
  treatedImageData String?          @db.Text // imagemTratada
  treatmentStatus  TreatmentStatus  @default(PENDING) // situacaoTratamento
  treatmentError   String? // erroTratamento
  /// Qual modelo venceu em cada polo e com que `borda` — a descontinuidade
  /// medida na junção. É o que permite auditar a qualidade sem reabrir o tour.
  treatmentMeta    Json? // dadosTratamento
  treatedAt        DateTime? // tratadoEm

  /// Ambientes que o corretor ligou a este na etapa de ordenação, na ordem em
  /// que os escolheu — ids de `Panorama`, e a ligação é recíproca (ligar Sala a
  /// Cozinha escreve nas duas).
  ///
  /// É a ÚNICA parte do wizard que não se deduz do resto. Nome do cômodo, ordem
  /// e capa estão em colunas; a passagem já posicionada é um `Hotspot`. A
  /// conexão ESCOLHIDA e ainda não posicionada não é nada — e era exatamente
  /// ela que o corretor perdia ao retomar um rascunho: a fila de trabalho da
  /// etapa de passagens voltava vazia com metade dos cômodos por ligar.
  ///
  /// Rascunho, e não verdade publicada: quem responde "existe passagem de A
  /// para B" continua sendo o `Hotspot`, aqui e no tour do visitante. Guardar
  /// isto como relação daria integridade a uma intenção que se descarta — id
  /// apontando para cômodo apagado já é caso tratado (`saidasEscolhidas` e
  /// `filaDePassagens` filtram os dois).
  draftConnections String[] @default([]) // conexoesDoRascunho

  /// Versão da linha, e é isso que o cache de imagem usa como identidade.
  ///
  /// A imagem de um panorama passou a ser servida por URL própria, com ETag e
  /// `Cache-Control` — e um cache sem forma de saber que a foto mudou serviria
  /// a antiga para sempre. `@updatedAt` cobre os dois casos que trocam pixel:
  /// a IA gravando `treatedImageData` e o corretor refotografando a sala.
  ///
  /// Renomear o cômodo também mexe aqui, invalidando um cache que continuava
  /// válido. Errar para o lado de baixar de novo é barato; errar para o outro
  /// mostra a foto errada sem nada denunciando.
  updatedAt DateTime @default(now()) @updatedAt // atualizadoEm

  virtualTour   VirtualTour @relation(fields: [virtualTourId], references: [id], onDelete: Cascade) // tourVirtual
  virtualTourId String

  originHotspots Hotspot[]     @relation("origin") // hotspotsOrigem
  targetHotspots Hotspot[]     @relation("target") // hotspotsDestino
  measurements   Measurement[] // medidas
  captureFrames  CaptureFrame[] // fotosOriginais

  /// Toda leitura de panorama é "os deste tour, na ordem" — quatro lugares
  /// fazem exatamente isso. O composto substitui o simples em `virtualTourId`.
  @@index([virtualTourId, order])
  /// O worker de IA varre por situação a cada boot (`updateMany` devolvendo
  /// PROCESSING para PENDING) e o CLI `--pendentes` faz o mesmo. Sem índice,
  /// os dois eram varredura completa de uma tabela com 196 MB em TOAST.
  @@index([treatmentStatus])
}

/// Foto individual da captura 360°, guardada como veio da câmera.
/// O panorama é um resultado montado e, portanto, recalculável: guardando as
/// fotos originais com a orientação de cada uma, uma costura melhor (ou a
/// etapa de IA) pode ser refeita depois sem pedir nova captura ao corretor.
model CaptureFrame {
  id        String @id @default(uuid())
  index     Int // ordem do disparo na captura
  imageData String @db.Text // base64 JPEG

  // Orientação da câmera no instante do disparo, no referencial da sessão.
  qx Float
  qy Float
  qz Float
  qw Float

  panorama   Panorama @relation(fields: [panoramaId], references: [id], onDelete: Cascade)
  panoramaId String

  createdAt DateTime @default(now())

  // Um reenvio depois de falha de rede repõe a mesma foto em vez de duplicá-la.
  @@unique([panoramaId, index])
  @@index([panoramaId])
}

model Hotspot {
  id        String  @id @default(uuid())
  label     String? // rotulo
  positionX Float // posicaoX
  positionY Float // posicaoY

  origin   Panorama @relation("origin", fields: [originId], references: [id], onDelete: Cascade) // origem
  originId String // origemId
  target   Panorama @relation("target", fields: [targetId], references: [id], onDelete: Cascade) // destino
  targetId String // destinoId

  @@index([originId])
  @@index([targetId])
}

model Measurement {
  id          String @id @default(uuid())
  description String // descricao
  value       Float // valor
  unit        String @default("m") // unidade

  panorama   Panorama @relation(fields: [panoramaId], references: [id], onDelete: Cascade)
  panoramaId String

  @@index([panoramaId])
}

model Visitor {
  id        String @id @default(uuid())
  sessionId String @unique // identificadorSessao

  shares Share[] // compartilhamentos
  views  View[] // visualizacoes

  createdAt DateTime @default(now())
}

model Share {
  id       String   @id @default(uuid())
  sharedAt DateTime @default(now()) // dataHora
  channel  String // canal

  virtualTour   VirtualTour @relation(fields: [virtualTourId], references: [id], onDelete: Cascade) // tourVirtual
  virtualTourId String
  visitor       Visitor     @relation(fields: [visitorId], references: [id], onDelete: Cascade) // visitante
  visitorId     String

  @@index([virtualTourId])
  @@index([visitorId])
}

model View {
  id              String   @id @default(uuid())
  viewedAt        DateTime @default(now()) // dataHora
  durationSeconds Int? // tempoPermanencia
  device          String? // dispositivo

  virtualTour   VirtualTour @relation(fields: [virtualTourId], references: [id], onDelete: Cascade) // tourVirtual
  virtualTourId String
  visitor       Visitor     @relation(fields: [visitorId], references: [id], onDelete: Cascade) // visitante
  visitorId     String

  @@index([virtualTourId])
  @@index([visitorId])
}
