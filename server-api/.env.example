# Copie para .env e preencha. NUNCA versione o .env.
#
# As variáveis marcadas [validada] passam pelo schema Zod em src/config/env.schema.ts:
# se faltarem ou vierem inválidas, a API NÃO SOBE — falha visível no boot em vez
# de fallback silencioso.

# ---------------------------------------------------------------------------
# OBRIGATÓRIAS — a API não inicia sem elas
# ---------------------------------------------------------------------------

# [validada] Conexão do Prisma. Formato:
# postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
#
# Atenção à porta: o Postgres de desenvolvimento é o do docker-compose e escuta
# na 5433, não na 5432. Ver o porquê no comentário de DB_PORT no fim do arquivo.
# Ex.: postgresql://postgres:SENHA@localhost:5433/property-360?schema=public
DATABASE_URL=

# [validada] Segredo do access token. Mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=

# [validada] Segredo do refresh token. Mínimo 32 caracteres e DIFERENTE do de acesso.
# Gere com o mesmo comando acima, numa segunda execução.
JWT_REFRESH_SECRET=

# ---------------------------------------------------------------------------
# OPCIONAIS — têm default; preencher conforme o ambiente
# ---------------------------------------------------------------------------

# [validada] development | test | production. Em production o Swagger em /docs
# é desabilitado. Default: development.
NODE_ENV=development

# [validada] Origens liberadas no CORS, separadas por vírgula. Vazio = nenhuma
# origem cross-origin (comportamento de dev, onde o proxy do Angular torna tudo
# same-origin). Preencher no deploy com o domínio real do frontend.
# Ex.: https://app.dominio.com,https://staging.dominio.com
CORS_ORIGINS=

# [validada] Domínios extras liberados em connect-src e img-src da CSP da API,
# separados por vírgula. Preencher na Fase 2 da migração de storage com o domínio
# do bucket. Atenção: a CSP do app Angular é servida por outro host e precisa
# receber o mesmo valor lá.
# Ex.: https://imagens.dominio.com
CSP_EXTRA_ORIGINS=

# Porta em que a API escuta. Lida direto de process.env em main.ts (não passa pelo
# schema). Default: 3000. Note que API_PORT abaixo é outra variável, usada só pelo
# docker-compose para mapear a porta do host.
# PORT=3000

# ---------------------------------------------------------------------------
# APENAS SCRIPTS — a API não lê nenhuma destas e não deixa de subir sem elas
# ---------------------------------------------------------------------------

# Chaves do bake-off de tratamento de panoramas (`yarn bakeoff-ia --gerar`).
#
# Sem elas o script roda em modo medição: mede o buraco de cobertura e a
# fotometria das capturas, e NÃO chama API nenhuma. Com elas, cada execução
# gasta de verdade — o script imprime o custo previsto antes de começar.
#
# Basta uma das duas: o bake-off roda com os modelos que tiverem chave.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Onde o bake-off procura `panoramas/`, `fotos-originais/` e `INDICE.md`, e onde
# escreve `bakeoff/`. Default: a mesma `imagens-exportadas/` que o
# `yarn exportar-capturas` alimenta.
BAKEOFF_OUT_DIR=

# ---------------------------------------------------------------------------
# APENAS DOCKER-COMPOSE — a aplicação não lê nenhuma destas
# ---------------------------------------------------------------------------

# Credenciais com que o compose cria o container do Postgres.
DB_USER=postgres
DB_PASSWORD=
DB_NAME=property-360

# Porta do host mapeada para o Postgres do container. É 5433 de propósito.
#
# A 5432 costuma estar ocupada por um Postgres instalado nativamente na máquina.
# O sintoma é traiçoeiro: as duas instâncias escutam em famílias de endereço
# diferentes (o nativo em IPv4 0.0.0.0, o container em IPv6 ::), então o Docker
# sobe sem erro de "porta em uso" e o `localhost` do DATABASE_URL resolve para o
# servidor nativo. O resultado é falha de autenticação, ou pior, uma conexão bem
# sucedida num banco vazio que parece o certo.
#
# Precisa casar com a porta usada no DATABASE_URL acima.
DB_PORT=5433

# Porta do host mapeada para o container da API.
API_PORT=3000
