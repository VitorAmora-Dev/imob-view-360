# Copie para .env e preencha. NUNCA versione o .env.
# Valores em branco são obrigatórios — a API não sobe sem eles.

# Database (consumidas pelo docker-compose)
DB_USER=postgres
DB_PASSWORD=
DB_NAME=property-360
DB_PORT=5432

# Application
API_PORT=3000

# Prisma (conexão local fora do Docker)
# postgresql://USUARIO:SENHA@localhost:5432/property-360?schema=public
DATABASE_URL=

# JWT — mínimo de 32 caracteres, e os dois valores DEVEM ser diferentes.
# Gere cada um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
